# Copy to .env and export it (e.g. `set -a; . ./.env; set +a`) before running.

# Only needed for gated or private checkpoints; openai/whisper-* are public.
# huggingface_hub reads it directly. Never commit a real token.
HF_TOKEN=

# Optional overrides for `whisper-finetune train` (CLI flags still win).
WHISPER_MODEL=openai/whisper-small
WHISPER_MANIFEST=data/processed/manifest.jsonl
WHISPER_OUTPUT_DIR=models/whisper-small
WHISPER_LANGUAGE=
WHISPER_DEVICE=auto
